# Secrets: never commit tokens, tickets or env files
.env
.env.*
!.env.example
*.token
*.secret

# Build output / runtime dirs
build/
run/
dist/
out/
.gradle/
mod/.gradle/

# Node
node_modules/
coverage/
*.tsbuildinfo

# Editors / OS
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# Minecraft instance credentials (T3 pairing tokens) — never commit
**/config/t3craft/credentials/

# Log4j output of local runs (mod/logs/latest.log)
mod/logs/

# Python caches (tools/art, tools/studio)
__pycache__/
*.pyc

# Renders never go into docs: they live on the render PC (Citadel Studio). The old research renders
# are in the tag archive/research-renders-2026-11-09.
docs/**/*.png

# Source package dev.t3craft.build is not build output
!mod/src/**/build/
