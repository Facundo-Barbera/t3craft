# Copy to bridge/.env (gitignored) for local runs only. No secrets in this file or in the repo.
# The bridge reads its settings from a JSON config (see config.example.json):
T3CRAFT_CONFIG=/home/<you>/.config/t3craft/bridge.json
# Tokens are NOT set here: each environment's token lives in the file named by
# environments[].tokenFile (absolute path outside the repo, chmod 600).
