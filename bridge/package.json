{
  "name": "t3craft-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Local bridge between the T3Craft Minecraft mod (ws://127.0.0.1:7878) and a T3 Code server (WebSocket RPC over Tailscale).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "probe": "tsx src/cli/probe.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "effect": "4.1.2",
    "ws": "8.22.1",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/ws": "8.18.2",
    "typescript": "7.0.2"
  }
}
