{
  "listen": {
    "host": "100.64.0.10",
    "port": 7878,
    "allowedHostnames": [
      "my-homelab.example.ts.net"
    ],
    "clientKeyFile": "/etc/t3craft/client.key"
  },
  "includeSubagents": false,
  "visibility": {
    "recentWindowHours": 24,
    "maxPerEnvironment": 40
  },
  "environments": [
    {
      "id": "vps",
      "label": "my-vps",
      "url": "https://my-vps.example.ts.net",
      "tokenFile": "/etc/t3craft/tokens/vps.token"
    },
    {
      "id": "laptop",
      "label": "my-laptop",
      "url": "http://my-laptop.example.ts.net:3773",
      "tokenFile": "/etc/t3craft/tokens/laptop.token"
    }
  ]
}
